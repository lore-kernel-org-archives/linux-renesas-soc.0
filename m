 				 <&audio_clk_a>, <&audio_clk_b>,
 				 <&audio_clk_c>,
@@ -1167,6 +1168,7 @@
 				      "src.9", "src.8", "src.7", "src.6",
 				      "src.5", "src.4", "src.3", "src.2",
 				      "src.1", "src.0",
+				      "mix.1", "mix.0",
 				      "ctu.1", "ctu.0",
 				      "dvc.0", "dvc.1",
 				      "clk_a", "clk_b", "clk_c", "clk_i";
@@ -1184,6 +1186,11 @@
 				};
 			};
 
+			rcar_sound,mix {
+				mix0: mix@0 { };
+				mix1: mix@1 { };
+			};
+
 			rcar_sound,ctu {
 				ctu00: ctu@0 { };
 				ctu01: ctu@1 { };
