> > +
> > +	dev_dbg(lvds->dev,
> > +		"%pC %lu Hz -> Fout %lu Hz (target %lu Hz, error %d.%02u%%), PLL
> > M/N/E/DIV %u/%u/%u/%u\n", +		clk, fin, output, target, error / 100,
> > +		error < 0 ? -error % 100 : error % 100,
> > +		pll->pll_m, pll->pll_n, pll->pll_e, pll->div);
> > +}
